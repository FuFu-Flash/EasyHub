{
  "name": "@easyhub/desktop",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "EasyHub Windows desktop application",
  "author": "EasyHub",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ui": "node smoke.mjs",
    "test:public-ui": "node public-browser-smoke.mjs",
    "test:discovery-ui": "node profile-discover-smoke.mjs",
    "test:responsive-ui": "node responsive-download-smoke.mjs",
    "test:translation-ui": "node paragraph-translation-smoke.mjs",
    "test:live-download": "node real-download-check.mjs",
    "test:live-local": "node real-local-project-check.mjs",
    "test:live-release": "node real-release-check.mjs",
    "test:live-translation": "node real-translation-check.mjs",
    "test:danger-ui": "node live-danger-smoke.mjs",
    "test:packaged": "node smoke.mjs --packaged",
    "test:demo-packaged": "node demo-smoke.mjs",
    "icons": "node generate-icons.mjs",
    "build": "electron-vite build",
    "package:win": "node package-win.mjs",
    "package:demo": "node package-demo.mjs"
  },
  "dependencies": {
    "@easyhub/github": "workspace:*",
    "@easyhub/types": "workspace:*",
    "@napi-rs/keyring": "^2.1.0",
    "https-proxy-agent": "^9.1.0",
    "isomorphic-git": "^1.42.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
